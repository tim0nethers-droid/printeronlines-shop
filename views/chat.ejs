<header class="guide-header">
  <a class="guide-brand" href="/">
    <span class="brand-mark">MP</span>
    <span>
      <strong>Product Help Portal</strong>
      <small>Independent product guides</small>
    </span>
  </a>
  <nav class="guide-nav" aria-label="Guide navigation">
    <a href="/">Home</a>
    <a href="/products">Products</a>
    <a href="<%= isMicrosoftGuideLanding ? '#product-guides' : '/products' %>">Guides</a>
    <a href="<%= isMicrosoftGuideLanding ? '#faq' : `/product/${selectedProduct.slug}#faq` %>">FAQ</a>
    <a href="/contact">Contact</a>
  </nav>
</header>

<% if (isMicrosoftGuideLanding) { %>
  <main class="microsoft-guide-chat-page">
    <section class="microsoft-chat-hero">
      <div class="microsoft-chat-hero-copy">
        <span class="eyebrow">Independent product information</span>
        <div class="product-logo product-logo-large microsoft" aria-hidden="true"><span>MS</span></div>
        <h1>Microsoft Product Help Guide</h1>
        <p>Independent information guide for Windows, Excel, Word, Outlook, OneDrive, Teams, and Microsoft 365.</p>
        <div class="guide-disclaimer-box">
          This is an independent product information and service request portal. We are not affiliated with Microsoft Corporation. We do not provide Microsoft-operated services, account access services, device-control sessions, or repair services.
        </div>
        <div class="hero-actions">
          <a class="button primary" href="#product-guides">View Product Guides</a>
          <a class="button secondary" href="#question-form">Submit a Product Question</a>
        </div>
      </div>
    </section>

    <section class="section" id="product-guides">
      <div class="section-heading">
        <span class="eyebrow">Product guides</span>
        <h2>Popular Microsoft Product Guides</h2>
      </div>
      <div class="microsoft-guide-grid">
        <% guideProducts.forEach((product) => { %>
          <article class="microsoft-guide-card">
            <div class="product-logo <%= product.iconClass %>" aria-hidden="true"><span><%= product.iconText %></span></div>
            <h3><%= product.name %> Guide</h3>
            <p>
              <% if (product.slug === 'windows') { %>
                Installation, updates, settings, activation information, and device guidance.
              <% } else if (product.slug === 'excel') { %>
                Formulas, workbook setup, charts, file opening, and data formatting.
              <% } else if (product.slug === 'word') { %>
                Document formatting, templates, printing, file opening, and PDF export.
              <% } else if (product.slug === 'outlook') { %>
                Email setup, calendar, app configuration, and send/receive guidance.
              <% } else if (product.slug === 'onedrive') { %>
                Sync guidance, storage information, file sharing, and backup setup.
              <% } else if (product.slug === 'teams') { %>
                Meetings, audio/video settings, chat notifications, and screen sharing.
              <% } else if (product.slug === 'microsoft-365') { %>
                Subscription information, app installation, Office apps, and OneDrive sync.
              <% } else { %>
                Browser setup, downloads, extensions, sync, and privacy settings.
              <% } %>
            </p>
            <a class="btn btn-outline" href="/product/<%= product.slug %>">Open Guide</a>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <span class="eyebrow">Safe topics</span>
        <h2>Common Product Topics</h2>
      </div>
      <div class="topic-card-grid">
        <% ['Product information', 'Setup guidance', 'Feature guide', 'File or app usage question', 'Documentation request', 'General product question'].forEach((topic) => { %>
          <article class="topic-card">
            <span aria-hidden="true">INFO</span>
            <h3><%= topic %></h3>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="section safety-panel">
      <div>
        <span class="eyebrow">Before you submit</span>
        <h2>Before You Submit a Question</h2>
        <p>Please do not share passwords, OTPs, recovery codes, product keys, payment details, or remote access information. This portal only collects general product questions and service request details.</p>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="section-heading">
        <span class="eyebrow">FAQ</span>
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="faq-card-list">
        <article>
          <h3>Is this operated by Microsoft?</h3>
          <p>No. This is an independent information and service request portal. We are not affiliated with Microsoft Corporation.</p>
        </article>
        <article>
          <h3>Can I submit a product question?</h3>
          <p>Yes. You can submit a general product question related to Windows, Excel, Word, Outlook, OneDrive, Teams, Microsoft 365, and other Microsoft products.</p>
        </article>
        <article>
          <h3>Do you ask for passwords or recovery codes?</h3>
          <p>No. Do not share passwords, OTPs, recovery codes, product keys, payment details, or remote access information.</p>
        </article>
        <article>
          <h3>Where can I find Microsoft-operated services?</h3>
          <p>For Microsoft-operated services, visit Microsoft's website directly.</p>
        </article>
      </div>
    </section>

    <section class="chat-page microsoft-form-section" id="question-form">
      <section class="chat-card">
        <div class="chat-product-logo product-logo microsoft" aria-hidden="true">
          <span>MS</span>
        </div>

        <h2>Submit a Product Question</h2>
        <p class="chat-subtitle">Share a general product question. Do not include passwords, OTPs, recovery codes, payment details, or remote access information.</p>

        <form id="chatStartForm" class="chat-start-form" novalidate>
          <input type="hidden" name="productSlug" value="microsoft">
          <input type="hidden" name="product" value="microsoft">

          <label for="chatName">Full Name</label>
          <input id="chatName" type="text" name="name" placeholder="Full Name" autocomplete="name" required>

          <label for="chatEmail">Email Address</label>
          <input id="chatEmail" type="email" name="email" placeholder="you@example.com" autocomplete="email" required>

          <label for="chatPhone">Phone Number</label>
          <input id="chatPhone" type="tel" name="phone" placeholder="Phone Number" autocomplete="tel" required>

          <label for="chatProductDisplay">Product</label>
          <input id="chatProductDisplay" type="text" value="Microsoft" readonly>

          <label for="chatTopic">Topic</label>
          <select id="chatTopic" name="issue" required>
            <option>Product information</option>
            <option>Setup guidance</option>
            <option>Feature guide</option>
            <option>General question</option>
            <option>File or app usage question</option>
            <option>Documentation request</option>
          </select>

          <label for="chatProblem">Describe Your Product Question</label>
          <textarea id="chatProblem" name="message" placeholder="Please describe your general product question. Do not include passwords, OTPs, recovery codes, or payment details." required></textarea>

          <div class="form-error" id="chatStartError" hidden></div>
          <button type="submit" class="chat-submit-btn">Submit Product Question</button>
        </form>

        <div id="chatWindow" class="chat-window" hidden>
          <div class="chat-window-header compact">
            <div>
              <span class="eyebrow">Conversation</span>
              <h2 id="chatTitle">Microsoft product question</h2>
            </div>
            <span class="status-pill" id="chatStatus">Open</span>
          </div>
          <div id="chatMessages" class="chat-messages" aria-live="polite"></div>

          <form id="chatReplyForm" class="chat-reply-form">
            <label class="sr-only" for="chatMessage">Message</label>
            <input id="chatMessage" type="text" name="message" placeholder="Type your message..." autocomplete="off" required>
            <button type="submit">Send</button>
          </form>
          <div class="form-error chat-inline-error" id="chatReplyError" hidden></div>
        </div>

        <p class="chat-footer-disclaimer"><%= disclaimer %></p>
      </section>
    </section>
  </main>
<% } else { %>
  <main class="chat-page">
    <section class="chat-card">
      <div class="chat-product-logo product-logo <%= selectedProduct.iconClass %>" aria-hidden="true">
        <span><%= selectedProduct.iconText %></span>
      </div>

      <h1><%= selectedProduct.name %> Message Intake</h1>

      <p class="chat-subtitle">Independent product information and request intake</p>
      <p class="chat-disclaimer-small">Not affiliated with Microsoft Corporation</p>

      <div class="chat-status">
        <span></span>
        Message intake open
      </div>

      <form id="chatStartForm" class="chat-start-form" novalidate>
        <input type="hidden" name="productSlug" value="<%= selectedProduct.slug %>">
        <input type="hidden" name="product" value="<%= selectedProduct.slug %>">
        <input type="hidden" name="issue" value="<%= categoryTitle(selectedProduct.categories[0]) %>">

        <label for="chatName">Full Name</label>
        <input id="chatName" type="text" name="name" placeholder="Full Name" autocomplete="name" required>

        <label for="chatEmail">Email Address</label>
        <input id="chatEmail" type="email" name="email" placeholder="you@example.com" autocomplete="email" required>

        <label for="chatPhone">Phone Number</label>
        <input id="chatPhone" type="tel" name="phone" placeholder="Phone Number" autocomplete="tel" required>

        <label for="chatProductDisplay">Product</label>
        <input id="chatProductDisplay" type="text" value="<%= selectedProduct.name %>" readonly>

        <label for="chatProblem">Describe Your Product Question</label>
        <textarea id="chatProblem" name="message" placeholder="Please describe your general product question. Do not include passwords, OTPs, recovery codes, or payment details." required></textarea>

        <div class="form-error" id="chatStartError" hidden></div>
        <button type="submit" class="chat-submit-btn">Send Message</button>
      </form>

      <div id="chatWindow" class="chat-window" hidden>
        <div class="chat-window-header compact">
          <div>
            <span class="eyebrow">Conversation</span>
            <h2 id="chatTitle"><%= selectedProduct.name %> product question</h2>
          </div>
          <span class="status-pill" id="chatStatus">Open</span>
        </div>
        <div id="chatMessages" class="chat-messages" aria-live="polite"></div>

        <form id="chatReplyForm" class="chat-reply-form">
          <label class="sr-only" for="chatMessage">Message</label>
          <input id="chatMessage" type="text" name="message" placeholder="Type your message..." autocomplete="off" required>
          <button type="submit">Send</button>
        </form>
        <div class="form-error chat-inline-error" id="chatReplyError" hidden></div>
      </div>

      <p class="chat-footer-disclaimer"><%= disclaimer %></p>
    </section>
  </main>
<% } %>
