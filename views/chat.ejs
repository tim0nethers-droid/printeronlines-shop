<% if (isPrinterChat) { %>
  <header class="printer-hub-header printer-chat-header">
    <div class="printer-hub-header-inner">
      <a class="printer-hub-brand" href="/printer" aria-label="Printer page home">
        <span class="printer-hub-mark">
          <span class="printer-mark-paper"></span>
          <span class="printer-mark-slot"></span>
        </span>
        <span>
          <strong>Printer Help Center</strong>
          <small>Independent Printer Guide</small>
        </span>
      </a>

      <button class="mobile-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <div class="mobile-menu-panel printer-chat-menu-panel">
        <nav class="printer-hub-nav" aria-label="Printer navigation">
          <a href="/printer">Home</a>
          <a href="/printer#brands">Guides</a>
          <a href="/printer#services">Services</a>
          <a href="/printer#setup">Drivers</a>
          <a href="/printer#faq">FAQ</a>
          <a href="/printer#contact">Contact</a>
        </nav>

        <div class="printer-hub-header-actions">
          <a class="printer-hub-icon-link" href="/printer-chat?product=printer" aria-label="Open printer chat">?</a>
          <a class="printer-hub-cta" href="/printer-chat?product=printer">Submit Question</a>
        </div>
      </div>
    </div>
  </header>
<% } else { %>
  <header class="guide-header">
    <a class="guide-brand" href="/">
      <span class="brand-mark">MP</span>
      <span>
        <strong>Product Request Portal</strong>
        <small>Independent product guides</small>
      </span>
    </a>
    <button class="mobile-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <div class="mobile-menu-panel guide-menu-panel">
      <nav class="guide-nav" aria-label="Guide navigation">
        <div class="nav-dropdown">
          <button class="nav-dropdown-toggle" type="button" aria-expanded="false">Products</button>
          <div class="nav-dropdown-menu">
            <a href="/products">All Products</a>
            <a href="/product/microsoft">Microsoft</a>
            <a href="/product/windows">Windows</a>
            <a href="/product/excel">Microsoft Excel</a>
            <a href="/product/word">Microsoft Word</a>
            <a href="/product/outlook">Microsoft Outlook</a>
            <a href="/product/onedrive">OneDrive</a>
            <a href="/product/teams">Teams</a>
          </div>
        </div>
        <a href="/products">AI Tools</a>
        <a href="/product/<%= selectedProduct.slug %>#articles">Resources</a>
        <a href="/product/<%= selectedProduct.slug %>#faq">FAQ</a>
        <a href="/contact">Contact</a>
      </nav>
      <div class="guide-actions">
        <a class="guide-search" href="/products" aria-label="Search products">Search</a>
        <select aria-label="Language">
          <option>EN</option>
          <option>HI</option>
        </select>
        <a class="guide-signin" href="/admin/login">Admin</a>
        <a class="guide-signup" href="/request?product=<%= selectedProduct.slug %>">Start Request</a>
      </div>
    </div>
  </header>
<% } %>

<main class="chat-page <%= isPrinterChat ? 'printer-chat-page' : '' %>">
  <section class="chat-card <%= isPrinterChat ? 'printer-chat-card' : '' %>">
    <div class="chat-product-logo product-logo <%= selectedProduct.iconClass %>" aria-hidden="true">
      <span><%= selectedProduct.iconText %></span>
    </div>

    <h1><%= isPrinterChat ? selectedProduct.name + ' Live Chat' : selectedProduct.name + ' Help Chat' %></h1>

    <p class="chat-subtitle"><%= isPrinterChat ? 'Independent printer setup and supplies assistant' : 'Independent AI-powered product assistant' %></p>
    <p class="chat-disclaimer-small"><%= isPrinterChat ? 'Not affiliated with printer manufacturers' : 'Not affiliated with Microsoft Corporation' %></p>

    <div class="chat-status">
      <span></span>
      AI assistant online
    </div>

    <form id="chatStartForm" class="chat-start-form" novalidate>
      <input type="hidden" name="productSlug" value="<%= selectedProduct.slug %>">

      <label for="chatName">Full Name</label>
      <input id="chatName" type="text" name="name" placeholder="Full Name" autocomplete="name" required>

      <label for="chatEmail">Email Address</label>
      <input id="chatEmail" type="email" name="email" placeholder="you@example.com" autocomplete="email" required>

      <label for="chatPhone">Phone Number</label>
      <input id="chatPhone" type="tel" name="phone" placeholder="Phone Number" autocomplete="tel" required>

      <input type="hidden" name="selectedIssue" id="selectedIssue" value="<%= (chatIssueOptions && chatIssueOptions[0]) || 'General product question' %>">

      <label for="chatProblem">Describe Your Problem</label>
      <textarea id="chatProblem" name="message" placeholder="Please describe your issue in detail..." required></textarea>

      <div class="issue-chip-group" data-issue-group aria-label="Common issues">
        <% (chatIssueOptions || []).forEach(function(issue, index) { %>
          <button class="issue-chip <%= index === 0 ? 'active' : '' %>" type="button" data-issue="<%= issue %>" aria-pressed="<%= index === 0 ? 'true' : 'false' %>"><%= issue %></button>
        <% }) %>
      </div>

      <p class="chat-safety-note">Do not share passwords, OTPs, recovery codes, product keys, payment details, or remote access information.</p>

      <div class="form-error" id="chatStartError" hidden></div>
      <button type="submit" class="chat-submit-btn">Start Help Chat</button>
      <p class="chat-secure-note">Secure and encrypted connection</p>
    </form>

    <div id="chatWindow" class="chat-window" hidden>
      <div class="chat-window-header compact">
        <div>
          <span class="eyebrow">Conversation</span>
          <h2 id="chatTitle"><%= selectedProduct.name %> chat</h2>
        </div>
        <span class="status-pill" id="chatStatus">Open</span>
      </div>
      <div id="chatMessages" class="chat-messages" aria-live="polite"></div>

      <form id="chatReplyForm" class="chat-reply-form">
        <label class="sr-only" for="chatMessage">Message</label>
        <input id="chatMessage" type="text" name="message" placeholder="Type your message..." autocomplete="off" required>
        <button type="submit">Send</button>
      </form>
      <div class="form-error chat-inline-error" id="chatReplyError" hidden></div>
    </div>

    <p class="chat-footer-disclaimer"><%= disclaimer %></p>
  </section>
</main>

<% if (isPrinterChat) { %>
  <footer class="printer-hub-footer printer-chat-footer">
    <div class="printer-hub-footer-inner">
      <div class="printer-hub-footer-brand">
        <div class="printer-hub-brand footer-brand-lockup">
          <span class="printer-hub-mark">
            <span class="printer-mark-paper"></span>
            <span class="printer-mark-slot"></span>
          </span>
          <span>
            <strong>Printer Help Center</strong>
            <small>Independent printer information portal</small>
          </span>
        </div>
        <p>Independent printer guides and request intake for setup, driver, wireless, offline, ink, toner, cartridge, scanner, and accessory questions.</p>
        <a class="printer-hub-footer-chat" href="/printer-chat?product=printer">Printer Message Intake</a>
      </div>

      <div>
        <h3>Printer Guides</h3>
        <a href="/printer">Printer Home</a>
        <a href="/printer-chat?product=hp-printer">HP Printer Guide</a>
        <a href="/printer-chat?product=epson-printer">Epson Printer Guide</a>
        <a href="/printer-chat?product=canon-printer">Canon Printer Guide</a>
        <a href="/printer-chat?product=brother-printer">Brother Printer Guide</a>
      </div>

      <div>
        <h3>Common Topics</h3>
        <a href="/printer-chat?product=printer&issue=Printer%20offline">Printer Offline</a>
        <a href="/printer-chat?product=printer&issue=Wireless%20printer%20setup">Wireless Setup</a>
        <a href="/printer-chat?product=printer&issue=Driver%20installation">Driver Installation</a>
        <a href="/printer-chat?product=printer&issue=Ink%20or%20toner%20question">Ink & Toner</a>
        <a href="/printer-chat?product=printer&issue=Scanner%20setup">Scanner Setup</a>
      </div>

      <div>
        <h3>Legal</h3>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/contact">Contact</a>
        <a href="/admin/login?next=%2Fadmin%2Fprinter-dashboard">Printer Admin</a>
      </div>
    </div>

    <div class="printer-hub-footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> Printer Help Center. All rights reserved.</span>
      <span>Independent information portal. Not affiliated with HP, Epson, Canon, Brother, or any printer manufacturer.</span>
    </div>
  </footer>
<% } %>

<script>
  window.CHAT_PAGE_PRODUCT = '<%= selectedProduct.slug %>';
</script>
