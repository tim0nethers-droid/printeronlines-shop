<section class="admin-header">
  <div class="admin-live-title-row">
    <div class="admin-brand-logo admin-live-logo <%= liveMode === 'printer' ? 'printer-admin-logo' : 'microsoft-admin-logo' %>"><%= adminBrandLogo || (liveMode === 'printer' ? 'PR' : 'MP') %></div>
    <div>
      <span class="eyebrow">Admin</span>
      <h1><%= liveTitle || 'Live Chat' %></h1>
      <p><%= adminBrandText || (liveMode === 'printer' ? 'Printer Help Center' : 'Product Help Portal') %></p>
    </div>
  </div>
  <div class="admin-actions">
    <a class="button secondary" href="<%= liveMode === 'printer' ? '/admin/printer-dashboard' : '/admin/dashboard' %>">Dashboard</a>
    <% if (liveMode === 'printer') { %>
      <a class="button secondary" href="/admin/live">Microsoft Admin</a>
    <% } else if (liveMode === 'microsoft') { %>
      <a class="button secondary" href="/admin/printer-live">Printer Admin</a>
    <% } else { %>
      <a class="button secondary" href="/admin/printer-live">Printer Live Chat</a>
    <% } %>
    <a class="button secondary" href="/admin/reports">Reports</a>
  </div>
</section>

<section class="section admin-live <%= liveMode === 'printer' ? 'printer-admin-live' : '' %>" data-default-product-filter="<%= defaultProductFilter || '' %>" data-live-mode="<%= liveMode || 'all' %>">
  <aside class="visitor-panel">
    <div class="panel-top">
      <label>
        Search
        <input id="adminChatSearch" type="search" placeholder="Search name, phone, product">
      </label>
      <label>
        Product
        <select id="liveProductFilter">
          <% if (liveMode === 'printer') { %>
            <option value="printer-family">All printer chats</option>
          <% } else if (liveMode === 'microsoft') { %>
            <option value="microsoft-family">All Microsoft chats</option>
          <% } else { %>
            <option value="">All products</option>
          <% } %>
          <% (liveProducts || products).forEach((product) => { %>
            <option value="<%= product.slug %>">[<%= product.iconText %>] <%= product.name %></option>
          <% }) %>
        </select>
      </label>
      <label class="toggle-row">
        <input type="checkbox" id="soundToggle" checked>
        New message sound
      </label>
      <div class="chat-list-filters" aria-label="Chat filters">
        <button type="button" class="active" data-list-filter="all">All</button>
        <button type="button" data-list-filter="open">Open</button>
        <button type="button" data-list-filter="pending">Pending</button>
        <button type="button" data-list-filter="closed">Closed</button>
        <button type="button" data-list-filter="unread">Unread</button>
      </div>
    </div>
    <div class="visitor-list" id="visitorList" aria-live="polite"></div>
  </aside>

  <section class="conversation-panel">
    <div class="conversation-meta" id="conversationMeta">
      <p>Select a visitor conversation.</p>
    </div>
    <div class="messages admin-messages" id="adminMessages"></div>
    <form class="chat-reply" id="adminReplyForm">
      <label class="sr-only" for="adminReply">Reply</label>
      <input id="adminReply" name="message" autocomplete="off" placeholder="Type a reply">
      <button class="button primary" type="submit">Reply</button>
    </form>
    <div class="status-controls">
      <button type="button" data-chat-status="Open">Open</button>
      <button type="button" data-chat-status="Pending">Pending</button>
      <button type="button" data-chat-status="Closed">Closed</button>
    </div>
    <div class="form-error" id="adminLiveError" hidden></div>
  </section>

  <aside class="visitor-details-panel">
    <div id="visitorDetails" class="visitor-details-card">
      <h2>Visitor Details</h2>
      <p>Select a visitor conversation to view details.</p>
    </div>
    <div class="quick-chat-actions">
      <button type="button" data-chat-status="Pending">Mark Pending</button>
      <button type="button" data-chat-status="Closed">Close Chat</button>
      <button type="button" id="exportChatButton">Export Chat</button>
    </div>
  </aside>
</section>
