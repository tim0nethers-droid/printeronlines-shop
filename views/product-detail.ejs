<header class="guide-header">
  <a class="guide-brand" href="/">
    <span class="brand-mark">MP</span>
    <span>
      <strong>Product Request Portal</strong>
      <small>Independent product guides</small>
    </span>
  </a>
  <button class="mobile-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <div class="mobile-menu-panel guide-menu-panel">
    <nav class="guide-nav" aria-label="Guide navigation">
      <a href="/">Home</a>
      <div class="nav-dropdown">
        <button class="nav-dropdown-toggle" type="button" aria-expanded="false">Products</button>
        <div class="nav-dropdown-menu">
          <a href="/products">All Products</a>
          <a href="/product/microsoft">Microsoft</a>
          <a href="/product/windows">Windows</a>
          <a href="/product/excel">Microsoft Excel</a>
          <a href="/product/word">Microsoft Word</a>
          <a href="/product/outlook">Microsoft Outlook</a>
          <a href="/product/onedrive">OneDrive</a>
          <a href="/product/teams">Teams</a>
        </div>
      </div>
      <a href="/products">AI Tools</a>
      <a href="#articles">Resources</a>
      <a href="#faq">FAQ</a>
      <a href="/contact">Contact</a>
    </nav>
    <div class="guide-actions">
      <a class="guide-search" href="/products" aria-label="Search products">Search</a>
      <select aria-label="Language">
        <option>English</option>
        <option>Hindi</option>
      </select>
      <a class="guide-signin" href="/admin/login">Admin</a>
      <a class="guide-signup" href="/request?product=<%= product.slug %>">Start Request</a>
    </div>
  </div>
</header>

<section class="product-hero <%= product.bannerClass %>">
  <div class="product-hero-left">
    <div class="product-logo product-logo-large <%= product.iconClass %>" aria-hidden="true">
      <span><%= product.iconText %></span>
    </div>
    <div>
      <h1><%= product.pageTitle %></h1>
      <p>Independent resource &mdash; not affiliated with Microsoft Corporation</p>
    </div>
  </div>

  <div class="product-hero-actions">
    <a href="#articles" class="hero-btn"><%= product.name %> Articles</a>
    <a href="/products" class="hero-btn">All Products</a>
  </div>
</section>

<nav class="product-tabs" aria-label="Product help sections">
  <a class="active" href="#troubleshooter">Troubleshooter</a>
  <a href="#articles">Articles</a>
  <a href="/request?product=<%= product.slug %>">Submit Ticket</a>
</nav>

<main class="product-help-layout">
  <section class="product-main">
    <div class="fast-help-card">
      <div class="fast-help-icon">BOT</div>
      <div>
        <h2>Have a product question?</h2>
        <p>Send a message to our independent request intake team.</p>
      </div>
      <a href="<%= chatHref(product) %>" class="btn-danger">Send Message</a>
    </div>

    <div class="guide-alert">
      Or select your issue below for step-by-step guidance.
    </div>

    <section class="help-articles product-intro">
      <span class="eyebrow">Product Help Guide</span>
      <h2><%= product.name %> help guide overview</h2>
      <p>This independent guide provides general information for <%= product.name %> questions such as <%= product.categories.slice(0, 5).map(categoryTitle).join(', ').toLowerCase() %>, and safe service request preparation.</p>
      <p><%= disclaimer %></p>
    </section>

    <div class="troubleshooter-card" id="troubleshooter">
      <h2><%= product.name %> Troubleshooter</h2>
      <p>Select your issue for step-by-step solutions.</p>

      <div class="issue-grid">
        <% product.categories.forEach(function(issue) { %>
          <a class="issue-card <%= selectedIssue && selectedIssue.slug === issue.slug ? 'active' : '' %>" href="/product/<%= product.slug %>/issue/<%= issue.slug %>">
            <div class="issue-icon"><%= issue.icon %></div>
            <h3><%= issue.title %></h3>
            <p><%= issue.description %></p>
          </a>
        <% }) %>
      </div>
    </div>

    <% if (selectedIssue) { %>
      <section class="issue-steps-card">
        <span class="eyebrow">Step-by-step guidance</span>
        <h2><%= selectedIssue.title %></h2>
        <p><%= selectedIssue.description %></p>
        <ol>
          <li>Review the product setting or file area related to this issue.</li>
          <li>Note the exact message, screen, or behavior without sharing account secrets.</li>
          <li>Try the basic app restart, refresh, or update check when relevant.</li>
          <li>Submit a ticket or start chat if the issue remains unclear.</li>
        </ol>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/request?product=<%= product.slug %>">Submit Ticket</a>
          <a class="btn btn-outline" href="<%= chatHref(product) %>">Send Message</a>
        </div>
      </section>
    <% } %>

    <section class="help-articles" id="articles">
      <span class="eyebrow">Help Articles</span>
      <h2>Common <%= product.name %> Questions</h2>
      <div class="article-list">
        <% product.categories.slice(0, 4).forEach(function(issue) { %>
          <a href="/product/<%= product.slug %>/issue/<%= issue.slug %>">
            <strong><%= issue.title %></strong>
            <span><%= issue.description %></span>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="help-articles">
      <span class="eyebrow">Setup Guidance</span>
      <h2><%= product.name %> setup guidance</h2>
      <p>Review the product area, device settings, app version, and visible error message before submitting a request. Please describe the issue without sharing passwords, one-time codes, recovery codes, payment card data, or account credentials.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/request?product=<%= product.slug %>">Submit a <%= product.name %> Service Request</a>
        <a class="btn btn-outline" href="<%= chatHref(product) %>">Start Live Chat</a>
      </div>
    </section>

    <section class="help-articles" id="faq">
      <span class="eyebrow">FAQ</span>
      <h2><%= product.name %> FAQs</h2>
      <div class="article-list">
        <article>
          <strong>Can I submit a <%= product.name %> question here?</strong>
          <span>Yes. You can send a general service request with your name, phone, email, selected product, issue category, and message.</span>
        </article>
        <article>
          <strong>Should I include passwords or codes?</strong>
          <span>No. Do not include passwords, one-time codes, recovery codes, payment details, remote access information, or account credentials.</span>
        </article>
        <article>
          <strong>Is this an official Microsoft website?</strong>
          <span>No. <%= disclaimer %></span>
        </article>
      </div>
    </section>

    <% if (relatedProducts && relatedProducts.length) { %>
      <section class="help-articles">
        <span class="eyebrow">Related Products</span>
        <h2>Related Microsoft product guides</h2>
        <div class="article-list">
          <% relatedProducts.forEach(function(related) { %>
            <a href="/product/<%= related.slug %>">
              <strong><%= related.name %></strong>
              <span><%= related.description %></span>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>
  </section>
  </section>

  <aside class="product-sidebar">
    <div class="need-help-card">
      <div class="product-logo small-logo <%= product.iconClass %>" aria-hidden="true">
        <span><%= product.iconText %></span>
      </div>
      <h2>Need Help Now?</h2>
      <strong>REQUEST REVIEW</strong>
      <p>Send your product question to this independent information and request portal.</p>
      <a href="<%= chatHref(product) %>" class="btn-danger full">Send Message</a>
      <small>Independent request intake, not affiliated with Microsoft Corporation</small>
    </div>

    <div class="quick-links-card">
      <h2>Quick Links</h2>
      <% product.quickLinks.forEach(function(link) { %>
        <% const quickHref = link === 'All Products' ? '/products' : link === 'Request Chat' ? chatHref(product) : `/request?product=${product.slug}`; %>
        <a href="<%= quickHref %>"><%= link %></a>
      <% }) %>
      <a href="/faq">FAQ</a>
    </div>

    <div class="disclaimer-card">
      <%= disclaimer %>
    </div>
  </aside>
</main>

<a class="floating-chat-btn" href="<%= chatHref(product) %>">Send Message</a>
