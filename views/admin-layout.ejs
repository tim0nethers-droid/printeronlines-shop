<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Independent product help portal admin panel.">
  <meta name="robots" content="noindex, nofollow">
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/style.css?v=20260722-printer-live-admin">
  <link rel="stylesheet" href="/css/admin.css?v=20260722-split-admin-logos">
</head>
<body class="admin-page" data-toast="<%= toast || '' %>">
  <div class="toast-container"></div>
  <%- body %>
  <% if (currentPath.startsWith('/admin/dashboard') || currentPath.startsWith('/admin/live') || currentPath.startsWith('/admin/printer-live')) { %>
    <script src="/socket.io/socket.io.js"></script>
  <% } %>
  <script src="/js/admin.js?v=20260630-dashboard-ring"></script>
  <% if (currentPath.startsWith('/admin/live') || currentPath.startsWith('/admin/printer-live')) { %>
    <script src="/js/admin-live.js?v=20260722-admin-next-redirect"></script>
  <% } %>
</body>
</html>
