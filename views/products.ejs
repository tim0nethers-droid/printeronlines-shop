<section class="page-hero compact">
  <div>
    <span class="eyebrow">Product directory</span>
    <h1>Products</h1>
    <p>Pick a product to view common issue categories and start a request.</p>
    <p class="disclaimer-note"><%= disclaimer %></p>
  </div>
  <div class="search-box page-search">
    <span aria-hidden="true">⌕</span>
    <input id="productSearch" type="search" placeholder="Search all products">
  </div>
</section>

<section class="section">
  <div class="products-grid product-grid wide" id="productGrid">
    <% productList.forEach((product) => { %>
      <article class="product-card" data-name="<%= product.name.toLowerCase() %>" data-categories="<%= product.categories.map(categoryTitle).join(' ').toLowerCase() %>">
        <a class="product-card-main" href="/product/<%= product.slug %>">
          <div class="product-logo <%= product.iconClass %>" aria-hidden="true"><span><%= product.iconText %></span></div>
          <h2><%= product.name %></h2>
          <p class="product-desc"><%= product.description %></p>
        </a>
        <div class="issue-tags">
          <% product.categories.slice(0, 3).forEach((category) => { %>
            <span><%= categoryTitle(category) %></span>
          <% }) %>
        </div>
        <div class="card-actions">
          <a class="btn btn-primary" href="/request?product=<%= product.slug %>">Start Request</a>
          <a class="btn btn-outline" href="/chat?product=<%= product.slug %>">Message Us</a>
        </div>
      </article>
    <% }) %>
  </div>
  <p class="empty-state" id="productEmpty" hidden>No matching products found.</p>
</section>
