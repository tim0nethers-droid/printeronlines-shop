<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= seoTitle || "Product Help Portal | Independent Microsoft Product Guides" %></title>
  <meta name="description" content="<%= seoDescription || "Independent product help guides, service requests, and live chat for Microsoft products. Not affiliated with Microsoft Corporation." %>">
  <meta name="keywords" content="<%= seoKeywords || "Microsoft product guide, Windows guide, Excel guide, Word guide, Outlook guide" %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta property="og:title" content="<%= seoTitle || pageTitle %>">
  <meta property="og:description" content="<%= seoDescription %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:site_name" content="Product Help Portal">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seoTitle || pageTitle %>">
  <meta name="twitter:description" content="<%= seoDescription %>">
  <meta name="robots" content="<%= robots || 'index, follow' %>">
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18203994396"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-18203994396');
  </script>
  <link rel="stylesheet" href="/css/style.css?v=20260630-header-footer-dropdowns">
  <% if (currentPath.startsWith('/admin')) { %>
    <link rel="stylesheet" href="/css/admin.css?v=20260629-saas-dashboard">
  <% } %>
  <% if (jsonLd) { %>
    <script type="application/ld+json"><%- jsonLd %></script>
  <% } %>
</head>
<body>
  <div class="site-shell">
    <% if (!guidePage) { %>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Home">
        <span class="brand-mark">MP</span>
        <span>
          <strong>Product Request Portal</strong>
          <small>Independent requests</small>
        </span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
        <div class="nav-dropdown">
          <button class="nav-dropdown-toggle <%= currentPath.startsWith('/products') || currentPath.startsWith('/product') ? 'active' : '' %>" type="button" aria-expanded="false">
            Products
          </button>
          <div class="nav-dropdown-menu">
            <a href="/products">All Products</a>
            <a href="/product/microsoft">Microsoft</a>
            <a href="/product/windows">Windows</a>
            <a href="/product/excel">Microsoft Excel</a>
            <a href="/product/word">Microsoft Word</a>
            <a href="/product/outlook">Microsoft Outlook</a>
            <a href="/product/onedrive">OneDrive</a>
            <a href="/product/teams">Teams</a>
          </div>
        </div>
        <a class="<%= currentPath.startsWith('/request') ? 'active' : '' %>" href="/request">Request</a>
        <a class="<%= currentPath.startsWith('/chat') ? 'active' : '' %>" href="/chat">Chat</a>
      </nav>
    </header>
    <% } %>

    <main>
      <%- body %>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-col footer-brand">
          <div class="footer-logo-row">
            <div class="footer-logo">MP</div>
            <div>
              <strong>Product Help Portal</strong>
              <span>Independent requests</span>
            </div>
          </div>
          <p><%= disclaimer %></p>
        </div>

        <div class="footer-col">
          <button class="footer-toggle" type="button" aria-expanded="true">Popular Products</button>
          <ul>
            <li><a href="/product/excel">Microsoft Excel</a></li>
            <li><a href="/product/word">Microsoft Word</a></li>
            <li><a href="/product/powerpoint">Microsoft PowerPoint</a></li>
            <li><a href="/product/outlook">Microsoft Outlook</a></li>
            <li><a href="/product/windows">Windows</a></li>
            <li><a href="/product/windows-11">Windows 11</a></li>
            <li><a href="/product/onedrive">OneDrive</a></li>
            <li><a href="/product/teams">Teams</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <button class="footer-toggle" type="button" aria-expanded="true">Guides</button>
          <ul>
            <li><a href="/product/microsoft-365">Microsoft 365</a></li>
            <li><a href="/product/windows-update">Windows Update</a></li>
            <li><a href="/product/microsoft-edge">Microsoft Edge</a></li>
            <li><a href="/product/onenote">OneNote</a></li>
            <li><a href="/product/sharepoint">SharePoint</a></li>
            <li><a href="/product/power-bi">Power BI</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <button class="footer-toggle" type="button" aria-expanded="true">Legal</button>
          <ul>
            <li><a href="/privacy-policy">Privacy Policy</a></li>
            <li><a href="/terms">Terms</a></li>
            <li><a href="/disclaimer">Disclaimer</a></li>
            <li><a href="/ad-transparency">Ad Transparency</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/faq">FAQ</a></li>
            <% if (isAdmin) { %>
              <li><a href="/admin/dashboard">Admin</a></li>
            <% } else { %>
              <li><a href="/admin/login">Admin Login</a></li>
            <% } %>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <span>&copy; <%= new Date().getFullYear() %> Product Help Portal. All rights reserved.</span>
        <span>Independent information portal. Not affiliated with Microsoft Corporation.</span>
      </div>
    </footer>
  </div>
  <script src="/js/main.js?v=20260630-header-footer-dropdowns"></script>
  <% if (currentPath.startsWith('/admin')) { %>
    <script src="/js/admin.js?v=20260629-saas-dashboard"></script>
  <% } %>
  <% if (currentPath.startsWith('/chat')) { %>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/chat-live.js?v=20260630-guide-assistant-replies"></script>
  <% } %>
  <% if (currentPath.startsWith('/admin/live')) { %>
    <script src="/js/admin-live.js?v=20260629-live-admin"></script>
  <% } %>
</body>
</html>
