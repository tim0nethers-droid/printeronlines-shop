<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= seoTitle || "Product Help Portal | Independent Microsoft Product Guides" %></title>
  <meta name="description" content="<%= seoDescription || "Independent product help guides, service requests, and live chat for Microsoft products. Not affiliated with Microsoft Corporation." %>">
  <meta name="keywords" content="<%= seoKeywords || "Microsoft product guide, Windows guide, Excel guide, Word guide, Outlook guide" %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta property="og:title" content="<%= seoTitle || pageTitle %>">
  <meta property="og:description" content="<%= seoDescription %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:site_name" content="Product Help Portal">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seoTitle || pageTitle %>">
  <meta name="twitter:description" content="<%= seoDescription %>">
  <meta name="robots" content="<%= robots || 'index, follow' %>">
  <link rel="stylesheet" href="/css/style.css?v=20260629-ads-compliance">
  <% if (currentPath.startsWith('/admin')) { %>
    <link rel="stylesheet" href="/css/admin.css?v=20260629-saas-dashboard">
  <% } %>
  <% if (jsonLd) { %>
    <script type="application/ld+json"><%- jsonLd %></script>
  <% } %>
</head>
<body>
  <div class="site-shell">
    <% if (!guidePage) { %>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Home">
        <span class="brand-mark">MP</span>
        <span>
          <strong>Product Request Portal</strong>
          <small>Independent requests</small>
        </span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
        <a class="<%= currentPath.startsWith('/products') || currentPath.startsWith('/product') ? 'active' : '' %>" href="/products">Products</a>
        <a class="<%= currentPath.startsWith('/request') ? 'active' : '' %>" href="/request">Request</a>
        <a class="<%= currentPath.startsWith('/chat') ? 'active' : '' %>" href="/chat">Chat</a>
      </nav>
    </header>
    <% } %>

    <main>
      <%- body %>
    </main>

    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <strong>Product Request Portal</strong>
          <p><%= disclaimer %></p>
        </div>
        <nav aria-label="Footer navigation">
          <strong>Popular Products</strong>
          <a href="/product/excel">Microsoft Excel</a>
          <a href="/product/word">Microsoft Word</a>
          <a href="/product/powerpoint">Microsoft PowerPoint</a>
          <a href="/product/outlook">Microsoft Outlook</a>
          <a href="/product/windows">Windows</a>
          <a href="/product/windows-11">Windows 11</a>
          <a href="/product/onedrive">OneDrive</a>
          <a href="/product/teams">Teams</a>
          <strong>Legal</strong>
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms">Terms</a>
          <a href="/disclaimer">Disclaimer</a>
          <a href="/ad-transparency">Ad Transparency</a>
          <a href="/contact">Contact</a>
          <a href="/faq">FAQ</a>
          <% if (isAdmin) { %>
            <a href="/admin/dashboard">Admin</a>
          <% } else { %>
            <a href="/admin/login">Admin Login</a>
          <% } %>
        </nav>
      </div>
    </footer>
  </div>
  <script src="/js/main.js?v=20260629-ads-compliance"></script>
  <% if (currentPath.startsWith('/admin')) { %>
    <script src="/js/admin.js?v=20260629-saas-dashboard"></script>
  <% } %>
  <% if (currentPath.startsWith('/chat')) { %>
    <script src="/js/chat.js?v=20260629-ads-compliance"></script>
  <% } %>
  <% if (currentPath.startsWith('/admin/live')) { %>
    <script src="/js/admin-live.js?v=20260629-live-admin"></script>
  <% } %>
</body>
</html>
