<div class="printer-hub-page">
  <header class="printer-hub-header">
    <div class="printer-hub-header-inner">
      <a class="printer-hub-brand" href="/printer" aria-label="Printer page home">
        <span class="printer-hub-mark">
          <span class="printer-mark-paper"></span>
          <span class="printer-mark-slot"></span>
        </span>
        <span>
          <strong>Printer Help Center</strong>
        <small>Independent Printer Guide</small>
        </span>
      </a>

      <nav class="printer-hub-nav" aria-label="Printer navigation">
        <a href="/printer">Home</a>
        <a href="#brands">Guides</a>
        <a href="#services">Services</a>
        <a href="#setup">Drivers</a>
        <a href="#compare">Compare</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="printer-hub-header-actions">
        <a class="printer-hub-icon-link" href="/printer-chat?product=printer" aria-label="Open printer chat">?</a>
        <a class="printer-hub-cta" href="/printer-chat?product=printer">Submit Question</a>
      </div>
    </div>
  </header>

  <section class="printer-hub-hero">
    <div class="printer-hub-hero-copy">
      <span class="printer-hub-pill">Live printer message intake</span>
      <h1>Printer Setup & Supplies Guide</h1>
      <p>Independent guidance for printer setup, wireless connection, driver installation, offline messages, print queue questions, ink, toner, cartridges, drums, scanner setup, and printer accessories.</p>
      <p class="printer-hub-seo-copy">Browse independent printer guide listings for HP, Canon, Epson, Brother, wireless printer setup, driver installation, printer offline status, ink and toner questions, cartridge compatibility, drum unit guidance, paper media, scanner setup, and general printer accessory information.</p>
      <div class="printer-hub-actions">
        <a class="printer-hub-btn primary" href="/printer-chat?product=printer">Submit Printer Question</a>
        <a class="printer-hub-btn secondary" href="#brands">Choose Printer Brand</a>
      </div>
      <p class="printer-hub-note">This is an independent printer information and request portal. We are not affiliated with HP, Epson, Canon, Brother, or any printer manufacturer.</p>

      <div class="printer-hub-stats">
        <div><strong>Open</strong><span>Message intake</span></div>
        <div><strong>Guided</strong><span>Topic routing</span></div>
        <div><strong>Safe</strong><span>No secret data</span></div>
        <div><strong>All</strong><span>Major brands</span></div>
      </div>
    </div>

    <aside class="printer-hub-instant-card">
      <div class="printer-hub-card-icon">PR</div>
      <h2>Guided Printer Topic Intake</h2>
      <p>Select a topic and open a printer chat intake for setup, offline, wireless, driver, ink, toner, cartridge, and scanner questions.</p>
      <div class="printer-hub-topic-list">
        <a href="/printer-chat?product=printer&issue=Printer%20offline">Printer offline</a>
        <a href="/printer-chat?product=printer&issue=Wireless%20printer%20setup">Wireless setup</a>
        <a href="/printer-chat?product=printer&issue=Driver%20installation">Driver installation</a>
        <a href="/printer-chat?product=printer&issue=Ink%20or%20toner%20question">Ink or toner</a>
      </div>
      <a class="printer-hub-btn primary full" href="/printer-chat?product=printer">Open Printer Intake</a>
    </aside>
  </section>

  <main>
    <section class="printer-ad-policy">
      <article>
        <strong>Independent Portal</strong>
        <p>Printer names are used only to identify guide topics. This page is not affiliated with any printer manufacturer.</p>
      </article>
      <article>
        <strong>Safe Message Intake</strong>
        <p>Do not submit passwords, OTPs, product keys, payment details, or remote access information.</p>
      </article>
      <article>
        <strong>Guide Content First</strong>
        <p>Browse setup, driver, ink, toner, scanner, paper, and accessory information before submitting a question.</p>
      </article>
    </section>

    <section class="printer-hub-section" id="brands">
      <div class="printer-hub-section-head">
        <span class="printer-hub-pill">Printer brands</span>
        <h2>Choose Your Printer Brand</h2>
        <p>Get brand-specific independent guidance and request intake.</p>
      </div>

      <div class="printer-hub-brand-grid">
        <% printerGuideProducts.filter(function(product) { return product.slug !== 'printer' && product.slug !== 'printer-setup'; }).forEach(function(product) { %>
          <a class="printer-hub-brand-card" href="/printer-chat?product=<%= product.slug %>">
            <div class="product-logo <%= product.iconClass %>" aria-hidden="true"><span><%= product.iconText %></span></div>
            <h3><%= product.name %> Guide</h3>
            <p><%= product.description %></p>
            <span>Get Guidance</span>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="printer-hub-section" id="services">
      <div class="printer-hub-section-head">
        <span class="printer-hub-pill">Home and office</span>
        <h2>Printer Setup, Usage Questions & Maintenance Guidance</h2>
        <p>Use safe message intake for general printer questions. Do not share passwords, payment details, OTPs, product keys, or remote access information.</p>
      </div>

      <div class="printer-hub-service-grid">
        <article class="printer-hub-service-card home">
          <div class="printer-hub-service-icon">HM</div>
          <h3>Home Printer Guidance</h3>
          <p>Information for inkjet printers, photo printers, wireless setup, paper loading, print quality, and scanner questions.</p>
          <ul>
            <li>Wireless connection guidance</li>
            <li>Printer offline questions</li>
            <li>Ink and cartridge information</li>
          </ul>
          <a href="/printer-chat?product=printer">Get Home Guidance</a>
        </article>

        <article class="printer-hub-service-card office">
          <div class="printer-hub-service-icon">OF</div>
          <h3>Office Printer Guidance</h3>
          <p>General guidance for laser printers, network printing, multifunction devices, queue issues, toner, drum units, and supplies planning.</p>
          <ul>
            <li>Network printer topics</li>
            <li>Driver installation guidance</li>
            <li>Toner and drum information</li>
          </ul>
          <a href="/printer-chat?product=printer">Get Office Guidance</a>
        </article>
      </div>
    </section>

    <section class="printer-hub-section printer-hub-blue" id="supplies">
      <div class="printer-hub-section-head light">
        <span class="printer-hub-pill light">Supplies</span>
        <h2>Printer Ink, Toner & Accessory Topics</h2>
        <p>Browse common supply and accessory topics for inkjet, laser, all-in-one, and photo printers.</p>
      </div>

      <div class="printer-hub-supply-grid">
        <% printerSupplyListings.forEach(function(item) { %>
          <a class="printer-hub-supply-card" href="/printer-chat?product=printer&issue=<%= encodeURIComponent(item[1]) %>">
            <span><%= item[0] %></span>
            <h3><%= item[1] %></h3>
            <p><%= item[2] %></p>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="printer-hub-section" id="listing">
      <div class="printer-hub-section-head">
        <span class="printer-hub-pill">Printer listing</span>
        <h2>Printer Guide Listings</h2>
        <p>Choose a printer brand, setup topic, supply topic, or accessory topic from this independent listing.</p>
      </div>

      <div class="printer-listing-grid">
        <article>
          <h3>Brand Guides</h3>
          <% printerGuideProducts.forEach(function(product) { %>
            <a href="/printer-chat?product=<%= product.slug %>"><%= product.name %> Guide</a>
          <% }) %>
        </article>

        <article>
          <h3>Setup Topics</h3>
          <% printerTopics.slice(0, 6).forEach(function(topic) { %>
            <a href="/printer-chat?product=printer&issue=<%= encodeURIComponent(topic) %>"><%= topic %></a>
          <% }) %>
        </article>

        <article>
          <h3>Supplies & Accessories</h3>
          <% printerSupplyListings.slice(0, 6).forEach(function(item) { %>
            <a href="/printer-chat?product=printer&issue=<%= encodeURIComponent(item[1]) %>"><%= item[1] %></a>
          <% }) %>
        </article>
      </div>
    </section>

    <section class="printer-hub-section" id="compare">
      <div class="printer-hub-section-head">
        <span class="printer-hub-pill">Compare</span>
        <h2>Find the Right Printer Type</h2>
        <p>Compare common printer types before you submit a setup or supplies question.</p>
      </div>

      <div class="printer-hub-compare-grid">
        <article>
          <strong>Inkjet</strong>
          <p>Best for photos, color graphics, home printing, and lower-volume usage.</p>
          <small>Common models: DeskJet, PIXMA, EcoTank, Envy Photo</small>
        </article>
        <article>
          <strong>Laser</strong>
          <p>Best for text documents, office workloads, toner use, and higher-volume printing.</p>
          <small>Common models: LaserJet, HL, imageCLASS</small>
        </article>
        <article>
          <strong>All-in-One</strong>
          <p>Best for print, scan, copy, document sharing, and multi-user home or office workflows.</p>
          <small>Common models: OfficeJet, WorkForce, MFC</small>
        </article>
      </div>
    </section>

    <section class="printer-hub-section" id="faq">
      <div class="printer-hub-section-head">
        <span class="printer-hub-pill">FAQ</span>
        <h2>Printer Help Center FAQs</h2>
        <p>Common questions about this independent printer information portal.</p>
      </div>

      <div class="printer-faq-grid">
        <% printerFaqs.forEach(function(faq) { %>
          <article>
            <h3><%= faq.question %></h3>
            <p><%= faq.answer %></p>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="printer-hub-section" id="setup">
      <div class="printer-hub-section-head">
        <span class="printer-hub-pill">Setup guide</span>
        <h2>Printer Setup & Installation Steps</h2>
        <p>Follow a general setup flow, then open a printer chat if you need topic-specific guidance.</p>
      </div>

      <div class="printer-hub-steps">
        <% [
          ['01', 'Unbox & Connect', 'Remove packaging, connect power, and turn the printer on.'],
          ['02', 'Install Ink or Toner', 'Insert cartridges or toner based on the printer panel guidance.'],
          ['03', 'Load Paper', 'Adjust paper guides and load compatible paper or media.'],
          ['04', 'Connect to Wi-Fi', 'Use the printer display or setup app to connect to your network.'],
          ['05', 'Install Drivers', 'Use manufacturer documentation to install the correct driver package.'],
          ['06', 'Print Test Page', 'Confirm printer status by printing a test page.']
        ].forEach(function(step) { %>
          <article>
            <span><%= step[0] %></span>
            <h3><%= step[1] %></h3>
            <p><%= step[2] %></p>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="printer-hub-final-cta" id="contact">
      <h2>Ready to Submit a Printer Question?</h2>
      <p>Open the printer message intake and choose the topic that matches your printer question.</p>
      <div>
        <a class="printer-hub-btn primary" href="/printer-chat?product=printer">Submit Printer Question</a>
        <a class="printer-hub-btn secondary" href="/request?product=printer">Submit Printer Request</a>
      </div>
    </section>
  </main>

  <footer class="printer-hub-footer">
    <div class="printer-hub-footer-inner">
      <div class="printer-hub-footer-brand">
        <div class="printer-hub-brand footer-brand-lockup">
          <span class="printer-hub-mark">
            <span class="printer-mark-paper"></span>
            <span class="printer-mark-slot"></span>
          </span>
          <span>
            <strong>Printer Help Center</strong>
            <small>Independent printer information portal</small>
          </span>
        </div>
        <p>Independent printer guides, supplies information, and request intake for common setup, driver, wireless, offline, ink, toner, cartridge, drum, scanner, and accessory questions.</p>
        <a class="printer-hub-footer-chat" href="/printer-chat?product=printer">Printer Message Intake</a>
        <small class="printer-hub-footer-status">Message intake available</small>
      </div>

      <div>
        <h3>Quick Links</h3>
        <a href="/printer">Home</a>
        <a href="/printer-chat?product=hp-printer">HP Printer Guide</a>
        <a href="/printer-chat?product=epson-printer">Epson Printer Guide</a>
        <a href="/printer-chat?product=canon-printer">Canon Printer Guide</a>
        <a href="/printer-chat?product=brother-printer">Brother Printer Guide</a>
      </div>

      <div>
        <h3>Services</h3>
        <a href="/printer-chat?product=printer&issue=Printer%20offline">Printer Offline</a>
        <a href="/printer-chat?product=printer&issue=Wireless%20printer%20setup">Network Setup</a>
        <a href="/printer-chat?product=printer&issue=Driver%20installation">Driver Installation</a>
        <a href="/printer-chat?product=printer&issue=Ink%20or%20toner%20question">Ink & Toner</a>
        <a href="/printer-chat?product=printer&issue=Scanner%20setup">Scanner Setup</a>
      </div>

      <div>
        <h3>Resources</h3>
        <a href="#supplies">Ink & Toner</a>
        <a href="#setup">Setup Steps</a>
        <a href="#compare">Compare Printers</a>
        <a href="#listing">Printer Listing</a>
        <a href="#faq">FAQs</a>
        <a href="/request?product=printer">Submit Request</a>
      </div>
    </div>

    <div class="printer-hub-footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> Printer Help Center. All rights reserved.</span>
      <span>Independent information portal. Not affiliated with HP, Epson, Canon, Brother, or any printer manufacturer.</span>
      <span>
        <a href="/privacy-policy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
      </span>
    </div>
  </footer>
</div>
